#include <stdio.h>
#include <stdlib.h>1
#include <string.h>
 
#define SERVICE_KM 5000
#define SERVICE_DAYS 180

struct Vehicle {
    char number[20];
    int day, month, year;
    int serviceMileage;
    int currentMileage;
    float avgDaily;
};
 
int monthDays[12] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
 
void clearInput()
{
    int c;
    while ((c = getchar()) != '\n' && c != EOF) {
    }
}
 
int readInt()
{
    int x;
    while (scanf("%d", &x) != 1) {
        clearInput();
        printf("Invalid input, enter a number: ");
    }
    return x;
}
 
float readFloat()
{
    float x;
    while (scanf("%f", &x) != 1) {
        clearInput();
        printf("Invalid input, enter a number: ");
    }
    return x;
}
 
int validDate(int d, int m, int y)
{
    if (y < 2000 || y > 2100) {
        return 0;
    }
    if (m < 1 || m > 12) {
        return 0;
    }
    if (d < 1 || d > monthDays[m - 1]) {
        return 0;
    }
    return 1;
}
 
void readDate(int *d, int *m, int *y)
{
    do {
        printf("(dd mm yyyy): ");
        *d = readInt();
        *m = readInt();
        *y = readInt();
        if (!validDate(*d, *m, *y)) {
            printf("Invalid date, try again.\n");
        }
    } while (!validDate(*d, *m, *y));
}
 
int toDays(int d, int m, int y)
{
    int total = y * 365 + d;
    int i;
    for (i = 0; i < m - 1; i++) {
        total = total + monthDays[i];
    }
    return total;
}
 
void addVehicle(struct Vehicle **list, int *count)
{
    struct Vehicle *temp;
    struct Vehicle v;
 
    printf("\nEnter vehicle number: ");
    scanf("%19s", v.number);
    clearInput();
 
    printf("Enter last service date ");
    readDate(&v.day, &v.month, &v.year);
 
    do {
        printf("Enter mileage at last service (km): ");
        v.serviceMileage = readInt();
        if (v.serviceMileage < 0) {
            printf("Mileage cannot be negative.\n");
        }
    } while (v.serviceMileage < 0);
 
    do {
        printf("Enter current mileage (km): ");
        v.currentMileage = readInt();
        if (v.currentMileage < v.serviceMileage) {
            printf("Current mileage cannot be less than service mileage.\n");
        }
    } while (v.currentMileage < v.serviceMileage);
 
    do {
        printf("Enter average daily usage (km/day): ");
        v.avgDaily = readFloat();
        if (v.avgDaily < 0) {
            printf("Usage cannot be negative.\n");
        }
    } while (v.avgDaily < 0);
 
    temp = (struct Vehicle *)realloc(*list, (*count + 1) * sizeof(struct Vehicle));
    if (temp == NULL) {
        printf("Memory not available!\n");
        return;
    }
    *list = temp;
    (*list)[*count] = v;
    *count = *count + 1;
 
    printf("Vehicle added successfully.\n");
}
 
int daysToNextService(struct Vehicle v)
{
    int kmUsed = v.currentMileage - v.serviceMileage;
    int kmLeft = SERVICE_KM - kmUsed;
 
    if (kmLeft <= 0) {
        return 0;
    }
    if (v.avgDaily <= 0) {
        return -1;
    }
    return (int)(kmLeft / v.avgDaily);
}
 
int isOverdue(struct Vehicle v, int today)
{
    int kmUsed = v.currentMileage - v.serviceMileage;
    int daysPassed = today - toDays(v.day, v.month, v.year);
 
    if (kmUsed >= SERVICE_KM || daysPassed >= SERVICE_DAYS) {
        return 1;
    }
    return 0;
}
 
void showVehicles(struct Vehicle *list, int count)
{
    int i;
    int d;
 
    if (count == 0) {
        printf("\nNo vehicles recorded yet.\n");
        return;
    }
 
    printf("\n%-15s %-12s %-10s %-10s %-10s %-15s\n", "Vehicle No", "Last Service", "Service km", "Current km", "Avg/day", "Next service in");
    for (i = 0; i < count; i++) {
        d = daysToNextService(list[i]);
        printf("%-15s %02d-%02d-%-6d %-10d %-10d %-10.1f ", list[i].number, list[i].day, list[i].month, list[i].year, list[i].serviceMileage, list[i].currentMileage, list[i].avgDaily);
        if (d == -1) {
            printf("Cannot predict\n");
        } else if (d == 0) {
            printf("Due now\n");
        } else {
            printf("%d days\n", d);
        }
    }
}
 
void checkAlerts(struct Vehicle *list, int count)
{
    int i;
    int today, dd, mm, yy;
    int found = 0;
 
    if (count == 0) {
        printf("\nNo vehicles recorded yet.\n");
        return;
    }
 
    printf("\nEnter today's date ");
    readDate(&dd, &mm, &yy);
    today = toDays(dd, mm, yy);
 
    printf("\n--- Service Alerts ---\n");
    for (i = 0; i < count; i++) {
        if (isOverdue(list[i], today)) {
            printf("ALERT: Vehicle %s is overdue for service!\n", list[i].number);
            found = 1;
        }
    }
    if (found == 0) {
        printf("No overdue vehicles. All good.\n");
    }
}
 
void updateMileage(struct Vehicle *list, int count)
{
    char num[20];
    int i;
    int newKm;
    int found = 0;
 
    printf("\nEnter vehicle number: ");
    scanf("%19s", num);
    clearInput();
 
    for (i = 0; i < count; i++) {
        if (strcmp(list[i].number, num) == 0) {
            printf("Enter new current mileage: ");
            newKm = readInt();
            if (newKm < list[i].currentMileage) {
                printf("New mileage cannot be less than old mileage.\n");
            } else {
                list[i].currentMileage = newKm;
                printf("Mileage updated.\n");
            }
            found = 1;
            break;
        }
    }
    if (found == 0) {
        printf("Vehicle not found.\n");
    }
}
 
int main()
{
    struct Vehicle *vehicles = NULL;
    int count = 0;
    int choice = 0;
 
    do {
        printf("\n===== Smart Vehicle Maintenance Tracker =====\n");
        printf("1. Add vehicle\n");
        printf("2. Show all vehicles\n");
        printf("3. Check overdue alerts\n");
        printf("4. Update vehicle mileage\n");
        printf("5. Exit\n");
        printf("Enter your choice: ");
        choice = readInt();
 
        switch (choice) {
            case 1:
                addVehicle(&vehicles, &count);
                break;
            case 2:
                showVehicles(vehicles, count);
                break;
            case 3:
                checkAlerts(vehicles, count);
                break;
            case 4:
                updateMileage(vehicles, count);
                break;
            case 5:
                printf("Exiting program. Goodbye!\n");
                break;
            default:
                printf("Invalid choice, try again.\n");
        }
    } while (choice != 5);
 
    free(vehicles);
    return 0;
}
 
